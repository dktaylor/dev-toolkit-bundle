{
    "name": "dktaylor/dev-toolkit-bundle",
    "description": "Reusable Symfony local dev-environment commands (dev:up/down/status/logs) and DX scaffolding.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": ["symfony", "bundle", "dev", "dx", "developer-experience"],
    "require": {
        "php": ">=8.4",
        "symfony/config": "^7.1 || ^8.0",
        "symfony/console": "^7.1 || ^8.0",
        "symfony/dependency-injection": "^7.1 || ^8.0",
        "symfony/http-kernel": "^7.1 || ^8.0",
        "symfony/process": "^7.1 || ^8.0",
        "symfony/yaml": "^7.1 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Dktaylor\\DevToolkit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dktaylor\\DevToolkit\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "install-tools": [
            "Dktaylor\\DevToolkit\\Composer\\ScriptHandler::installTools"
        ],
        "post-install-cmd": [
            "@install-tools"
        ],
        "post-update-cmd": [
            "@install-tools"
        ],
        "phpstan": [
            "tools/phpstan/vendor/bin/phpstan analyse --no-progress"
        ],
        "cs-fix": [
            "Dktaylor\\DevToolkit\\Composer\\ScriptHandler::csFix"
        ],
        "cs-check": [
            "Dktaylor\\DevToolkit\\Composer\\ScriptHandler::csCheck"
        ],
        "psalm": [
            "tools/psalm/vendor/bin/psalm --taint-analysis"
        ],
        "security-check": [
            "composer audit"
        ],
        "test": [
            "phpunit"
        ],
        "quality": [
            "@phpstan",
            "@cs-check",
            "@psalm",
            "@security-check",
            "@test"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        },
        "dev-tools": [
            "tools/phpstan",
            "tools/php-cs-fixer",
            "tools/psalm"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}